# 复制为 .env 后填写
# 支持任何 OpenAI 兼容服务，示例为 DeepSeek
# 注意：此密钥仅用于本地开发兜底；公网部署时，网页用户必须自带 X-LLM-Key，否则返回 400
OPENAI_API_KEY=sk-your-deepseek-key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash

# 公网部署防滥用令牌（前端 docs/config.js 中保持一致，所有接口需携带）
# Authorization: Bearer <API_TOKEN>
API_TOKEN=change-me-to-a-random-string